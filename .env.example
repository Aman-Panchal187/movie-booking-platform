# Copy to .env for local development. NEVER commit real values.

# ---- Core ----
NODE_ENV=development
PORT=3000
# Neon: postgres://USER:PASSWORD@HOST/DB?sslmode=require   (SSL is enabled automatically for neon.tech / sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mbp
DB_POOL_MAX=10
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- CORS / proxy ----
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Number of trusted proxy hops in front of Express. 1 = Nginx (local compose and the Render container).
TRUST_PROXY=1

# ---- Cache / rate-limit counters: set ONE (Upstash REST wins if both are set; neither = in-process memory) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=redis://localhost:6379

# ---- Media (Cloudinary). Optional: uploads return 503 until configured; pasted https URLs always work ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Observability ----
LOG_LEVEL=info
# Optional OTLP/HTTP collector base URL, e.g. http://jaeger:4318. Tracing is disabled when empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Required to read /metrics in production
METRICS_TOKEN=

# ---- Booking tuning ----
HOLD_DURATION_SECONDS=300
MAX_SEATS_PER_BOOKING=8

# ---- Local-only seed accounts (admin@demo.local, manager@demo.local, customer@demo.local). Refused when NODE_ENV=production ----
DEMO_PASSWORD=

# ---- One-time admin bootstrap (npm run admin:create). Pass on the command line / secret manager; do not commit ----
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---- Frontend (Vite) ----
# Empty = same origin (dev proxy). Production: https://<your-render-service>.onrender.com
VITE_API_BASE_URL=
