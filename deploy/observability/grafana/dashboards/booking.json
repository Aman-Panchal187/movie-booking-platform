{
  "title": "Movie Booking API",
  "uid": "mbp-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requests / s by status", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (status) (rate(http_requests_total[1m]))", "legendFormat": "{{status}}" }] },
    { "id": 2, "type": "timeseries", "title": "p95 latency (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))" }] },
    { "id": 3, "type": "timeseries", "title": "Seat holds vs conflicts", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(seat_holds_total[1m])", "legendFormat": "holds" }, { "expr": "rate(booking_conflicts_total[1m])", "legendFormat": "conflicts (409)" }] },
    { "id": 4, "type": "timeseries", "title": "Mock payments", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum by (outcome) (rate(mock_payments_total[1m]))", "legendFormat": "{{outcome}}" },
                  { "expr": "rate(payment_idempotent_replays_total[1m])", "legendFormat": "idempotent replays" }] },
    { "id": 5, "type": "stat", "title": "Confirmed bookings", "gridPos": { "x": 0, "y": 16, "w": 6, "h": 5 },
      "targets": [{ "expr": "bookings_confirmed_total" }] },
    { "id": 6, "type": "timeseries", "title": "Cache hits / misses / errors", "gridPos": { "x": 6, "y": 16, "w": 9, "h": 5 },
      "targets": [{ "expr": "sum by (result) (rate(cache_events_total[1m]))", "legendFormat": "{{result}}" }] },
    { "id": 7, "type": "timeseries", "title": "Process memory (MB)", "gridPos": { "x": 15, "y": 16, "w": 9, "h": 5 },
      "targets": [{ "expr": "process_resident_memory_bytes / 1024 / 1024" }] },
    { "id": 8, "type": "stat", "title": "Postgres connectivity failures", "gridPos": { "x": 0, "y": 21, "w": 6, "h": 4 },
      "targets": [{ "expr": "postgres_connectivity_failures_total" }] }
  ]
}
